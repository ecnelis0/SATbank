# Copy to .env and fill in. Never commit .env.

# --- Database ---
# Local dev default (no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./sat_bank.db
# Production (Neon Postgres):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require

# --- AI analyzer ---
# stub   = deterministic offline analysis, no API key, used by tests
# claude = Anthropic API
# openai = OpenAI API
# agent  = the Claude Code CLI, paid for by the plan you are logged into
AI_PROVIDER=stub
# ANTHROPIC_API_KEY=sk-ant-...
# For AI_PROVIDER=openai. The model must read pictures (the screenshot scanner)
# and return structured output.
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-opus-5

# --- Frontend ---
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
